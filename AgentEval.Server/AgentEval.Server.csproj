<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AgentEval.Server</RootNamespace>
    <!-- The OpenAPI document is written only when scripts/.internal/api-types.sh asks for it. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="grate.postgresql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Applied at start-up by grate from the output directory (Database/Migrations/up/). -->
    <None Include="Database/Migrations/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentEval.Server.Tests" />
  </ItemGroup>
</Project>
