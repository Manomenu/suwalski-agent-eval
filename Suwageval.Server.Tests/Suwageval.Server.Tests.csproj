<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Suwageval.Server/Suwageval.Server.csproj" />
    <!-- Aliased: the CLI has a top-level Program of its own, like the server. -->
    <ProjectReference Include="../Suwageval.Cli/Suwageval.Cli.csproj" Aliases="Cli" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The sample agent folder the push tests push. Its one copy lives in the CLI's tests; this links it into this output, never copies it. -->
    <None Include="../Suwageval.Cli.Tests/Sample/**" LinkBase="Sample" CopyToOutputDirectory="PreserveNewest" />
    <!-- Stored answers of the judge model: the two real ones captured once from qwen38 (passed, failed), the others written by hand to be malformed. -->
    <None Update="Judges/Answers/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
