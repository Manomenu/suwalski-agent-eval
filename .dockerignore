# The build context is the solution root for both images, so everything heavy and
# everything machine-local has to be kept out of it.
.git
.github
.claude
.vscode
.artifacts
docs/
deploy/
# The CLI and its tests are not in any image, and the contracts only once the server references them.
Suwageval.Cli/
Suwageval.Cli.Tests/
Suwageval.Contracts/

**/node_modules/
**/dist/
**/bin/
**/obj/
**/TestResults/

# Secrets never enter a build context, let alone an image layer.
**/.env
.secrets/
