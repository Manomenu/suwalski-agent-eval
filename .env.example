# Copy to .env (gitignored) and fill in. Read by `just server`, `just up` (compose) and scripts/.internal/live-check.sh.
# Addresses on the owner's network never go in a committed file (AGENTS.md, section 7).

# The judge's model: an OpenAI-compatible server, endpoints directly under the URL ({BaseUrl}/chat/completions).
Models__judge__BaseUrl=http://<host>/<path>
Models__judge__Model=<model name>
# Only for a server that asks for a key; leave out otherwise.
Models__judge__ApiKey=<key>

# Where `just agent-publish` pushes Suwageval.AgentSdk (AGENTS.md, section 12), and its push key.
AGENT_SDK_FEED_URL=https://<host>/<path>
AGENT_SDK_FEED_API_KEY=<key>
