# Copy to .env (gitignored) and fill in. Read by `just server`, `just up` (compose), `just agent-publish-local` and scripts/.internal/live-check.sh.
# Addresses on the owner's network never go in a committed file (AGENTS.md, section 7).

# The one model Suwageval needs: an OpenAI-compatible server, endpoints directly under the URL ({BaseUrl}/chat/completions).
# The judge, the simulated user and the user describer all use it unless one has its own entry below.
Models__fallback__BaseUrl=http://<host>/<path>
Models__fallback__Model=<model name>
# Only for a server that asks for a key; leave out otherwise.
Models__fallback__ApiKey=<key>
# Optional: a model of its own for the judge (judge checks, $judge arguments). Left out, the judge uses the fallback.
# Models__judge__BaseUrl=http://<host>/<path>
# Models__judge__Model=<model name>
# Models__judge__ApiKey=<key>
# Models__judge__MaxConcurrency=8
# Optional: a model of its own for the simulated user (simulated scenarios). Left out, it uses the fallback.
# Models__simulator__BaseUrl=http://<host>/<path>
# Models__simulator__Model=<model name>
# Models__simulator__ApiKey=<key>
# Models__simulator__MaxConcurrency=8
# A separate model for the user describer (a scenario drafted from a conversation, the rest simulated). Left out, it uses the fallback.
# Models__describer__BaseUrl=http://<host>/<path>
# Models__describer__Model=<model name>
# Models__describer__ApiKey=<key>
# Models__describer__MaxConcurrency=8
# How freely the simulated user writes, 0 to 2 (default 0.7).
# Simulation__Temperature=0.7

# Not needed for a normal release: `just agent-publish` runs a workflow that holds no key (Trusted Publishing).
# Only for the fallback `just agent-publish-local` (AGENTS.md, section 12): a nuget.org key for a first release the workflow cannot make.
# AGENT_SDK_NUGET_API_KEY=<key>
# Optional, same fallback: publish to another feed instead of nuget.org. Both or neither; the feed gets its own key, never the one above.
# AGENT_SDK_FEED_URL=https://<host>/<push path>
# AGENT_SDK_FEED_API_KEY=<key>
