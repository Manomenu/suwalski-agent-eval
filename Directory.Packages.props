<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="gate">
    <PackageVersion Include="Suwgate.Architecture" Version="0.4.0" />
    <PackageVersion Include="Suwgate.Database" Version="0.4.0" />
  </ItemGroup>
  <ItemGroup Label="server">
    <PackageVersion Include="Suwbackkit.Server" Version="0.5.1" />
    <PackageVersion Include="Suwbackkit.Postgres" Version="0.5.1" />
    <PackageVersion Include="Suwbackkit.Cli" Version="0.5.1" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.1" />
  </ItemGroup>
  <ItemGroup Label="cli">
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Suwbackkit.Testing" Version="0.5.1" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
