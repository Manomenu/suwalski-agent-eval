<!--
  Central package management: every NuGet package and its version is named once, here. A
  project only references the package by name. A package arrives in the same change as the
  first code that uses it (AGENTS.md, section 0).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="server">
    <!-- the OpenAPI document the web client is typed from -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- writes that document at build time, without a database (scripts/.internal/api-types.sh) -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <!-- SQL written by hand, rows mapped onto records — no ORM -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- PostgreSQL: a pooled data source -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- schema migrations: one-time SQL scripts, run once, edits detected (RoundhousE's successor) -->
    <PackageVersion Include="grate.postgresql" Version="2.1.6" />
    <!-- Microsoft Agent Framework: the judge is a ChatClientAgent over a chat client -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.25.0" />
    <!-- the OpenAI-compatible chat client (a vLLM server) behind IChatClient -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
  </ItemGroup>
  <ItemGroup Label="cli">
    <!-- commands, arguments and options of the suwageval CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- reads the YAML files an agent's repository keeps, with line and column of every value -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="agent contracts">
    <!-- only for net8.0: the strict options of ContractJson need version 9 -->
    <PackageVersion Include="System.Text.Json" Version="9.0.10" />
  </ItemGroup>
  <ItemGroup Label="tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- the server's import contracts (AGENTS.md, section 4) -->
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
