root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx,config}]
indent_size = 2

[*.{cs,csproj,props,targets}]
max_line_length = 140

[*.cs]
dotnet_diagnostic.JSON002.severity = none

[{Suwageval.Server.Tests,Suwageval.Cli.Tests,Suwageval.Gate}/**.cs]
dotnet_diagnostic.CA2100.severity = none

[{Suwageval.Contracts,Suwageval.AgentSdk}/**.cs]
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1056.severity = none

[Suwageval.Cli/Program.cs]
dotnet_diagnostic.RS0030.severity = none
