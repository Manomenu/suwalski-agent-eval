<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org only, whatever sources the machine has configured: with a second source (a company feed)
  central package management raises NU1507, and TreatWarningsAsErrors turns it into a failed build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
