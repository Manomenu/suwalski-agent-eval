{
    "editor.formatOnSave": true,
    "[csharp]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode"
    },
    "files.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/TestResults": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/*.tsbuildinfo": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "README.md": "AGENTS.md, CLAUDE.md, TODO.md, LICENSE, justfile, .editorconfig, .gitignore, .gitattributes, .dockerignore, compose.yaml, suwgate.yml, criteria.json",
        "Suwageval.slnx": "global.json, Directory.Build.props, Directory.Build.rsp, Directory.Packages.props, layers.json",
        "*.csproj": "packages.lock.json",
        "appsettings.json": "appsettings.*.json",
        "package.json": "pnpm*, .npm*, eslint*, .eslint*, prettier*, knip*, tsconfig*.json, vite.config.ts, index.html",
        "*.ts": "${capture}.js, ${capture}.*.ts",
        "*.tsx": "${capture}.ts, ${capture}.*.ts, ${capture}.*.tsx"
    },
    "dotnet.defaultSolution": "Suwageval.slnx",
    "yaml.schemas": { "./Suwageval.Web/node_modules/@maniumek/suwgate/schema/suwgate.schema.json": "suwgate.yml" },
    "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "fullSolution",
    "dotnet.backgroundAnalysis.compilerDiagnosticsScope": "fullSolution",
    "dotnet.testWindow.useTestingPlatformProtocol": true,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "eslint.workingDirectories": ["Suwageval.Web"],
    "prettier.prettierPath": "Suwageval.Web/node_modules/prettier"
}
